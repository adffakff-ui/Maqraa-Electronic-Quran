{
  "version": 2,
  "name": "society-quran-portal",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/download",
      "dest": "/app/build/outputs/apk/debug/app-debug.apk"
    },
    {
      "src": "/apk",
      "dest": "/app/build/outputs/apk/debug/app-debug.apk"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
