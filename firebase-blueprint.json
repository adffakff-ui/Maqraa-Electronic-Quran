{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Represents a Quranic society or educational institution.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the society tenant."
        },
        "name": {
          "type": "string",
          "description": "Full formal name of the society."
        },
        "shortName": {
          "type": "string",
          "description": "Shortened recognizable name."
        },
        "city": {
          "type": "string",
          "description": "City where the society is located."
        },
        "code": {
          "type": "string",
          "description": "Unique society administrative code."
        },
        "ringsCount": {
          "type": "integer",
          "description": "Total number of Quran rings."
        },
        "studentsCount": {
          "type": "integer",
          "description": "Total registered students."
        },
        "teachersCount": {
          "type": "integer",
          "description": "Total assigned teachers."
        },
        "attendanceRate": {
          "type": "integer",
          "description": "Overall attendance rate percentage."
        },
        "unreadMessagesCount": {
          "type": "integer",
          "description": "Pending unread alerts count."
        },
        "licenseNumber": {
          "type": "string",
          "description": "Official government accreditation license number."
        },
        "country": {
          "type": "string",
          "description": "Country of operation."
        },
        "governorate": {
          "type": "string",
          "description": "Governorate or province."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last update."
        }
      },
      "required": ["id", "name", "city", "code"]
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Central registry of Quranic societies and tenants."
    }
  }
}
